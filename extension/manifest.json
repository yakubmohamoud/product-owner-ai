{
  "manifest_version": 3,
  "name": "MY PO",
  "version": "1.0.1",
  "description": "Turn meeting recordings and documents into reviewed requirements, Jira work and Confluence pages.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://my-product-owner-ai.onrender.com/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Product Owner AI",
    "default_popup": "popup.html"
  }
}