# Application
NODE_ENV=development
LOG_LEVEL=INFO
APP_SECRET=generate-a-random-secret-with-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIRECTORY=.data
EXTENSION_ORIGIN=chrome-extension://replace-with-your-extension-id
TRUST_PROXY=false

# Database & Cache
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/agile_saas
REDIS_URL=redis://localhost:6379/0

# LLM Platform Defaults (Used when BYOK is disabled)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
MANAGED_MAX_OUTPUT_TOKENS=4096
# Managed API cost basis and customer markup. Rates are micro-USD per million tokens.
LLM_INPUT_COST_MICRO_USD_PER_MILLION=150000
LLM_OUTPUT_COST_MICRO_USD_PER_MILLION=600000
# Optional per-model override, keyed by the configured model name.
LLM_MODEL_PRICING_JSON='{"gpt-4o-mini":{"input_micro_usd_per_million":150000,"output_micro_usd_per_million":600000}}'
MANAGED_LLM_MARKUP_BPS=3000
MANAGED_CREDIT_PACK_MICRO_USD=25000000
AUTH_RATE_LIMIT_MAX=20
LLM_RATE_LIMIT_MAX=30
# Optional: maximum request bytes accepted by the JSON API
REQUEST_BODY_LIMIT=10mb
ANTHROPIC_API_KEY=sk-ant-...

# Google Identity / Drive OAuth: register http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Atlassian OAuth 2.0 (3LO): register http://localhost:3000/auth/atlassian/callback
ATLASSIAN_CLIENT_ID=...
ATLASSIAN_CLIENT_SECRET=...
# Legacy aliases also accepted:
JIRA_CLIENT_ID=...
JIRA_CLIENT_SECRET=...

# Integrations not yet connected
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
TEAMS_APP_ID=...
TEAMS_APP_PASSWORD=...
ZOOM_CLIENT_ID=...
ZOOM_CLIENT_SECRET=...

# Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BYOK=price_monthly_byok_...
STRIPE_PRICE_MANAGED_CREDITS=price_one_time_credit_pack_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_PAYG=price_metered_...
STRIPE_METER_EVENT_NAME=ai_units
